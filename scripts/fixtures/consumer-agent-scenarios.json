{
  "schemaVersion": "consumer-agent-scenario-v1",
  "synthetic": true,
  "note": "Synthetic test clients only. Never real client data. Each scenario carries what the client SAYS, what a correct planner extracts from it, and what the planning engine must then do. The runner replays every scenario through both the agent and voice-equivalent transports and requires them to agree.",
  "scenarios": [
    {
      "id": "young_renter_first_home",
      "client": {
        "identity": "25, renting, early in a first job",
        "circumstances": "renting a flat, saving a deposit, no property, no pension yet",
        "knownFacts": "you are 25; you have about 12,000 euro saved",
        "wants": "to buy a first home in a few years and know if you are on track",
        "style": "friendly, a bit unsure of the jargon",
        "behaviours": [
          "gives round numbers",
          "asks what things mean"
        ]
      },
      "turns": [
        {
          "say": "I'm 25 and renting at the moment, and I really want to buy my first place in a few years.",
          "extraction": {
            "goals": [
              {
                "type": "buy_home",
                "priorityHint": "primary"
              }
            ],
            "facts": [
              {
                "factId": "person_current_age",
                "value": {
                  "age": 25
                }
              },
              {
                "factId": "property_status",
                "value": {
                  "value": "renter"
                }
              }
            ]
          }
        },
        {
          "say": "I've got about twelve thousand put away so far.",
          "extraction": {
            "positions": [
              {
                "kind": "cash",
                "entityId": "savings",
                "label": "Savings",
                "amount": {
                  "amount": 12000,
                  "currency": "EUR"
                }
              }
            ]
          }
        }
      ],
      "expected": {
        "mustPersistGoals": [
          "buy_home"
        ],
        "mustSelectModuleIds": [
          "house_purchase"
        ],
        "mustNeverSelectModuleIds": [
          "pension_projection",
          "mortgage_analysis"
        ],
        "mustNeverAskFactIds": [
          "intended_retirement_age",
          "pension_employer_contribution_rate"
        ],
        "mustPersistFactIds": [
          "person_current_age"
        ]
      }
    },
