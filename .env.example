# Required PostgreSQL connection URL for the learning-signal service and migration runner.
DATABASE_URL=postgresql://planeir:planeir_local_only@127.0.0.1:5432/planeir_telemetry

# Local Compose database name.
POSTGRES_DB=planeir_telemetry

# Local Compose database user.
POSTGRES_USER=planeir

# Local-only Compose password; use a secret-managed value outside development.
POSTGRES_PASSWORD=planeir_local_only

# Host port exposed by the local PostgreSQL container.
POSTGRES_PORT=5432

# Interface on which the service listens.
SERVICE_HOST=127.0.0.1

# Port on which the service listens.
SERVICE_PORT=3000

# Runtime mode: development, test, or production.
NODE_ENV=development

# Structured-log level; request/response bodies and credentials are never logged.
LOG_LEVEL=info

# Optional PostHog project key; absent means the PostHog no-op sink is used.
POSTHOG_API_KEY=

# PostHog ingest host; the EU endpoint is the default.
POSTHOG_HOST=https://eu.i.posthog.com

# Optional Langfuse public key. Absent keeps both Langfuse paths dormant: the
# learning-signals outbox (metadata-only, masked by config/observability.yaml)
# and the Worker's live-call tracing in worker/src/consumer/tracing.js.
LANGFUSE_PUBLIC_KEY=

# Optional Langfuse secret key. Paired with the public key above; set both or
# neither. In the Worker these are set with `wrangler secret put`, not here.
LANGFUSE_SECRET_KEY=

# Optional Langfuse host; the EU region is the default when unset. The Worker
# additionally requires this to be an https URL before it will trace.
LANGFUSE_HOST=https://cloud.langfuse.com

# The agent harness reads the same three variables. A harness run publishes full
# prompts and completions, which is safe because it only ever replays synthetic
# personas and the scenario library -- never a real session. Live Worker traces
# carry conversation text only for a cohort in CONSUMER_AGENT_TEST_COHORTS;
# every other cohort, production included, is metadata-only.

# Optional OpenTelemetry OTLP exporter endpoint; absent means the OTel no-op exporter is used.
OTEL_EXPORTER_OTLP_ENDPOINT=

# Tenant-secret backend: env for the pilot or kms for managed deployments (the KMS provider is a fail-closed stub).
TENANT_SECRET_PROVIDER=env

# Optional pilot keyring JSON. Keep blank to boot without correction OR session writes (both pseudonymise with the tenant key); use canonical lowercase UUIDs and base64url-encoded CSPRNG output of at least 32 bytes.
# `make provision` prints the entry to add here for a newly onboarded tenant.
# Retain historical keys after rotation: {"00000000-0000-4000-8000-000000000000":{"current_version":2,"keys":{"1":"old-base64url-key","2":"current-base64url-key"}}}
TENANT_SECRETS_JSON=

# Pilot differential-privacy switch; enabling it invokes the explicit not-implemented guard.
DP_ENABLED=false

# Reserved differential-privacy epsilon configuration surface; no pilot noise is implemented.
DP_EPSILON=1.0

# Optional Parquet/R2 export switch; pilot default is off.
PARQUET_EXPORT_ENABLED=false

# Background outbox polling cadence in milliseconds.
OUTBOX_POLL_INTERVAL_MS=1000

# Initial outbox retry delay in milliseconds; retries use exponential backoff.
OUTBOX_RETRY_BASE_MS=1000

# Maximum outbox retry delay in milliseconds.
OUTBOX_RETRY_MAX_MS=60000
