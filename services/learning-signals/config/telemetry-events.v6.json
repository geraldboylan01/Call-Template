{
  "$schema": "https://planeir.example/schemas/telemetry-event-catalog.v3.json",
  "version": "telemetry-events-v6",
  "events": {
    "call.connected": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 2,
        "required": [],
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "voice"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "channel",
        "late"
      ],
      "forward_envelope": []
    },
    "call.hung_up": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "cause_class"
        ],
        "properties": {
          "cause_class": {
            "type": "string",
            "enum": [
              "technical",
              "non_technical"
            ],
            "maxLength": 256
          },
          "cause_detail": {
            "type": "string",
            "enum": [
              "technical_failure",
              "network_dropout",
              "provider_error",
              "user_ended",
              "user_declined",
              "timeout",
              "completed",
              "other"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "cause_class",
        "cause_detail",
        "late"
      ],
      "forward_envelope": []
    },
    "review.started": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 2,
        "required": [],
        "properties": {
          "reviewer_role": {
            "type": "string",
            "enum": [
              "adviser",
              "admin"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "reviewer_role",
        "late"
      ],
      "forward_envelope": []
    },
    "review.completed": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [],
        "properties": {
          "reviewer_role": {
            "type": "string",
            "enum": [
              "adviser",
              "admin"
            ],
            "maxLength": 256
          },
          "corrections_made": {
            "type": "string",
            "enum": [
              "none",
              "some"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "reviewer_role",
        "corrections_made",
        "late"
      ],
      "forward_envelope": []
    },
    "review.abandoned": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 2,
        "required": [],
        "properties": {
          "stage": {
            "type": "string",
            "enum": [
              "identity",
              "income",
              "assets",
              "liabilities",
              "goals",
              "risk",
              "other"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "stage",
        "late"
      ],
      "forward_envelope": []
    },
    "module.enter": {
      "consent_class": "contract_necessity",
      "server_owned": [
        "module_version_id"
      ],
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "module_id"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          },
          "module_version_id": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "module_id",
        "module_version_id",
        "late"
      ],
      "forward_envelope": [
        "turn_index"
      ]
    },
    "module.exit": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "module_id",
          "outcome"
        ],
        "properties": {
          "module_id": {
            "type": "string",
            "format": "uuid",
            "maxLength": 36
          },
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "abandoned"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "module_id",
        "outcome",
        "late"
      ],
      "forward_envelope": [
        "turn_index",
        "duration_ms"
      ]
    },
    "meeting.booked": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 2,
        "required": [],
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "voice",
              "adviser_ui"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "channel",
        "late"
      ],
      "forward_envelope": []
    },
    "session.started": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "channel",
          "source"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "voice"
            ],
            "maxLength": 256
          },
          "source": {
            "type": "string",
            "enum": [
              "orchestrator",
              "adviser_ui",
              "extraction_pipeline"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "channel",
        "source",
        "late"
      ],
      "forward_envelope": []
    },
    "question.prompted": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 5,
        "required": [
          "question_kind",
          "sequence"
        ],
        "properties": {
          "question_kind": {
            "type": "string",
            "enum": [
              "identity",
              "income",
              "assets",
              "liabilities",
              "goals",
              "risk",
              "consent",
              "other"
            ],
            "maxLength": 256
          },
          "question_id": {
            "type": "string",
            "format": "id_slug",
            "maxLength": 64
          },
          "sequence": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "retry": {
            "type": "boolean"
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "question_kind",
        "sequence",
        "retry",
        "late",
        "question_id"
      ],
      "forward_envelope": [
        "turn_index"
      ]
    },
    "question.completed": {
      "consent_class": "improvement_signal",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 5,
        "required": [
          "outcome",
          "value_class"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "answered",
              "skipped",
              "declined",
              "timeout"
            ],
            "maxLength": 256
          },
          "value_class": {
            "type": "string",
            "enum": [
              "provided",
              "not_provided",
              "banded"
            ],
            "maxLength": 256
          },
          "question_id": {
            "type": "string",
            "format": "id_slug",
            "maxLength": 64
          },
          "duration_bucket": {
            "type": "string",
            "enum": [
              "under_5s",
              "5_to_15s",
              "16_to_30s",
              "over_30s"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "outcome",
        "value_class",
        "duration_bucket",
        "late",
        "question_id"
      ],
      "forward_envelope": [
        "turn_index",
        "duration_ms"
      ]
    },
    "extraction.completed": {
      "consent_class": "improvement_signal",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 4,
        "required": [
          "field_kind",
          "result",
          "confidence_band"
        ],
        "properties": {
          "field_kind": {
            "type": "string",
            "enum": [
              "identity",
              "income",
              "asset",
              "liability",
              "goal",
              "risk"
            ],
            "maxLength": 256
          },
          "result": {
            "type": "string",
            "enum": [
              "extracted",
              "missing",
              "ambiguous"
            ],
            "maxLength": 256
          },
          "confidence_band": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "field_kind",
        "result",
        "confidence_band",
        "late"
      ],
      "forward_envelope": [
        "turn_index",
        "duration_ms"
      ]
    },
    "extraction.corrected": {
      "ingestion": "internal",
      "consent_class": "improvement_signal",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 4,
        "required": [
          "value_class",
          "change_kind",
          "reason_code"
        ],
        "properties": {
          "value_class": {
            "type": "string",
            "enum": [
              "identifier",
              "age",
              "currency",
              "categorical",
              "date",
              "boolean",
              "number"
            ],
            "maxLength": 256
          },
          "change_kind": {
            "type": "string",
            "enum": [
              "changed",
              "unchanged"
            ],
            "maxLength": 256
          },
          "reason_code": {
            "type": "string",
            "enum": [
              "incorrect_value",
              "missing_value",
              "misclassified",
              "formatting",
              "other"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [
        "value_class",
        "change_kind",
        "reason_code",
        "late"
      ],
      "forward_envelope": []
    },
    "session.completed": {
      "consent_class": "contract_necessity",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 4,
        "required": [
          "outcome",
          "turn_count"
        ],
        "properties": {
          "outcome": {
            "type": "string",
            "enum": [
              "completed",
              "abandoned",
              "failed"
            ],
            "maxLength": 256
          },
          "turn_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 10000
          },
          "abandonment_cause": {
            "type": "string",
            "enum": [
              "technical",
              "non_technical"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "required_when": [
        {
          "property": "outcome",
          "in": [
            "abandoned",
            "failed"
          ],
          "require": [
            "abandonment_cause"
          ]
        }
      ],
      "forward_attrs": [
        "outcome",
        "turn_count",
        "abandonment_cause",
        "late"
      ],
      "forward_envelope": [
        "duration_ms"
      ]
    },
    "demographics.band.recorded": {
      "consent_class": "optional_demographics",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "dimension",
          "band"
        ],
        "properties": {
          "dimension": {
            "type": "string",
            "enum": [
              "age",
              "income",
              "region",
              "household_size"
            ],
            "maxLength": 256
          },
          "band": {
            "type": "string",
            "enum": [
              "under_18",
              "18_to_24",
              "25_to_34",
              "35_to_44",
              "45_to_54",
              "55_to_64",
              "65_to_74",
              "75_plus",
              "under_25k",
              "25k_to_49k",
              "50k_to_99k",
              "100k_to_249k",
              "250k_plus",
              "urban",
              "suburban",
              "rural",
              "one",
              "two",
              "three_plus",
              "unknown"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [],
      "forward_envelope": []
    },
    "marketing.referral.recorded": {
      "consent_class": "marketing_referral",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 3,
        "required": [
          "channel"
        ],
        "properties": {
          "channel": {
            "type": "string",
            "enum": [
              "adviser",
              "client_referral",
              "partner",
              "event",
              "organic",
              "paid",
              "other",
              "unknown"
            ],
            "maxLength": 256
          },
          "campaign_category": {
            "type": "string",
            "enum": [
              "branded",
              "non_branded",
              "unknown"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [],
      "forward_envelope": []
    },
    "consent.withdrawn": {
      "consent_class": "consent_control",
      "attrs_schema": {
        "$schema": "http://json-schema.org/draft-07/schema#",
        "type": "object",
        "additionalProperties": false,
        "maxProperties": 2,
        "required": [
          "consent_type"
        ],
        "properties": {
          "consent_type": {
            "type": "string",
            "enum": [
              "service_improvement_telemetry",
              "partner_benchmarking",
              "optional_demographics",
              "marketing_referral"
            ],
            "maxLength": 256
          },
          "late": {
            "type": "boolean"
          }
        }
      },
      "forward_attrs": [],
      "forward_envelope": []
    }
  }
}
