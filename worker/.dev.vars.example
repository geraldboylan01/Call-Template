# Copy only the entries you need into worker/.dev.vars. Never commit real keys.
# Generate the encryption key with: npm run generate:consumer-key
# The separate CONSUMER_DB is a Wrangler D1 binding, not a .dev.vars entry.
# Follow docs/consumer-journey-operations.md before enabling the journey.

CONSUMER_DATA_ENCRYPTION_KEY="replace-with-a-32-byte-base64url-key"
CONSUMER_DATA_ENCRYPTION_KEY_ID="consumer-v1"
CONSUMER_REKEY_BATCH_SIZE="25"
# Optional read-only key ring during rotation, with at most three prior keys.
CONSUMER_DATA_ENCRYPTION_PREVIOUS_KEYS_JSON="{}"

# Start fail closed. The journey can run in deterministic rules-only mode without
# an OpenAI key after its D1 binding, migration, policy id, and TTL are reviewed.
CONSUMER_JOURNEY_ENABLED="false"
CONSUMER_AI_INTAKE_ENABLED="false"
CONSUMER_VOICE_ENABLED="false"
CONSUMER_REALTIME_VOICE_ENABLED="false"
CONSUMER_MODULE_ROUTING_ENABLED="false"
CONSUMER_HANDOFF_ENABLED="false"
CONSUMER_PUBLIC_ACCESS_ENABLED="false"
CONSUMER_INVITE_SIGNING_KEY="replace-with-a-32-byte-base64url-hmac-key"
# Used only to pseudonymise rate-limit subjects before they reach D1.
CONSUMER_RATE_LIMIT_HASH_KEY="replace-with-a-different-32-byte-base64url-hmac-key"
CONSUMER_INVITE_MAX_TTL_HOURS="168"
CONSUMER_ALLOWED_MODULE_IDS="house_purchase,liquidity_analysis"
CONSUMER_COHORT="internal"
CONSUMER_CONSENT_POLICY_VERSION="consumer-v1"
CONSUMER_CONSENT_MANIFEST_ID=""
# Keep these empty until the exact, approved notices are published. Runtime
# configuration stays fail closed when a required notice or HTTPS URL is absent.
CONSUMER_ANALYSIS_NOTICE_ID=""
CONSUMER_AI_NOTICE_ID=""
CONSUMER_VOICE_NOTICE_ID=""
CONSUMER_PRIVACY_NOTICE_URL=""
CONSUMER_SESSION_TTL_DAYS="30"
CONSUMER_MAX_MESSAGE_LENGTH="4000"
CONSUMER_MAX_TURNS_PER_SESSION="80"

# Enable only after adding a real secret locally or with `wrangler secret put`.
OPENAI_API_KEY=""
# Keep empty until an approved provider/data-processing policy id and AI notice
# are assigned.
CONSUMER_AI_DATA_POLICY_ID=""
CONSUMER_AI_DEFAULT_MODEL="gpt-5.6-luna"
CONSUMER_AI_COMPLEX_MODEL="gpt-5.6-terra"
CONSUMER_AI_DEFAULT_REASONING_EFFORT="low"
CONSUMER_AI_COMPLEX_REASONING_EFFORT="medium"
CONSUMER_AI_PROMPT_VERSION="consumer-intake-v1"
CONSUMER_AI_TIMEOUT_MS="15000"
CONSUMER_AI_MAX_OUTPUT_TOKENS="1200"
CONSUMER_AI_REQUEST_TOKEN_RESERVATION="8000"
CONSUMER_AI_SESSION_REQUEST_BUDGET="24"
CONSUMER_AI_DAILY_REQUEST_BUDGET="1000"
CONSUMER_AI_COMPLEX_SESSION_REQUEST_BUDGET="4"
CONSUMER_AI_COMPLEX_DAILY_REQUEST_BUDGET="100"
CONSUMER_AI_SESSION_TOKEN_BUDGET="25000"
CONSUMER_AI_DAILY_TOKEN_BUDGET="250000"

# Bounded record-review voice remains available as the non-realtime fallback.
# Keep it disabled until its separate notice, policy, and budget are reviewed.
CONSUMER_VOICE_DATA_POLICY_ID=""
CONSUMER_VOICE_TRANSCRIPTION_MODEL=""
CONSUMER_VOICE_SPEECH_MODEL=""
CONSUMER_VOICE_NAME=""
CONSUMER_VOICE_PRICING_VERSION=""
CONSUMER_VOICE_TIMEOUT_MS="25000"
CONSUMER_VOICE_MAX_AUDIO_BYTES="1000000"
CONSUMER_VOICE_MAX_DURATION_SECONDS="45"
CONSUMER_VOICE_MAX_SPEECH_CHARACTERS="1200"
CONSUMER_VOICE_SESSION_BUDGET_EUR_CENTS="0"
CONSUMER_VOICE_DAILY_BUDGET_EUR_CENTS="0"
CONSUMER_VOICE_TRANSCRIPTION_RESERVATION_EUR_CENTS="0"
CONSUMER_VOICE_SPEECH_RESERVATION_EUR_CENTS="0"

# Realtime voice uses the CONSUMER_REALTIME_SESSIONS Durable Object binding in
# wrangler.toml, not a .dev.vars secret. These source values intentionally fail
# closed. Use the reviewed adviser-canary values from the operations runbook
# only in a private local file or the protected production workflow.
CONSUMER_REALTIME_NOTICE_ID=""
CONSUMER_REALTIME_DATA_POLICY_ID=""
CONSUMER_REALTIME_MODEL=""
CONSUMER_REALTIME_VOICE=""
CONSUMER_REALTIME_REASONING_EFFORT=""
CONSUMER_REALTIME_TRANSCRIPTION_MODEL=""
CONSUMER_REALTIME_PROMPT_VERSION=""
CONSUMER_REALTIME_TOOLSET_VERSION=""
CONSUMER_REALTIME_PRICING_VERSION=""
CONSUMER_REALTIME_SESSION_BUDGET_EUR_CENTS="0"
CONSUMER_REALTIME_DAILY_BUDGET_EUR_CENTS="0"
CONSUMER_REALTIME_MAX_DURATION_SECONDS="600"
CONSUMER_REALTIME_IDLE_TIMEOUT_SECONDS="90"
CONSUMER_REALTIME_MAX_SDP_BYTES="32768"
CONSUMER_REALTIME_MAX_RESPONSES="40"
CONSUMER_REALTIME_MAX_TOOL_CALLS="24"
CONSUMER_REALTIME_TEXT_INPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_TEXT_CACHED_INPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_TEXT_OUTPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_AUDIO_INPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_AUDIO_CACHED_INPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_AUDIO_OUTPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_TRANSCRIPTION_INPUT_EUR_MICROS_PER_MILLION="0"
CONSUMER_REALTIME_TRANSCRIPTION_OUTPUT_EUR_MICROS_PER_MILLION="0"

# Handoff stays disabled until these values come from an approved policy. Do not
# copy illustrative retention periods into production as a legal decision.
CONSUMER_HANDOFF_POLICY_VERSION=""
CONSUMER_HANDOFF_POLICY_URL=""
CONSUMER_HANDOFF_RETENTION_POLICY_ID=""
CONSUMER_HANDOFF_RETENTION_DAYS=""

# Optional future booking provider. Must be an HTTPS URL.
CONSUMER_BOOKING_URL=""
