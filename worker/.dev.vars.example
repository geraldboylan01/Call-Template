# Local `wrangler dev` config for the learning-signal integration.
# Copy to worker/.dev.vars (gitignored) and fill with your Render values to test
# a LOCAL worker against the HOSTED service. In production these are set via
# wrangler.toml [vars] (URL + MODULE_ID, non-secret) and `wrangler secret put`
# (INGEST_KEY, secret). All three must be present or the emitter is a no-op.
LEARNING_SIGNALS_URL=https://your-service.onrender.com
LEARNING_SIGNALS_MODULE_ID=00000000-0000-0000-0000-000000000000
LEARNING_SIGNALS_INGEST_KEY=your-ingest-key-here
